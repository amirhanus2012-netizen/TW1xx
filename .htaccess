# ==============================================================================
# NEXUS VR - PROXY SHIELD & WEB APPLICATION FIREWALL (WAF) CONFIGURATION
# Protects against DDoS, Bad Bots, SQL Injection, Cross-Site Scripting (XSS),
# and enforces strict SSL/TLS and Reverse Proxy headers.
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Enforce HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block Bad Bots, Scrapers & Vulnerability Scanners
    RewriteCond %{HTTP_USER_AGENT} ^.*(libwww-perl|wget|python|nikto|curl|scan|sqlmap|nmap|havij|masscan|morfeus).* [NC]
    RewriteRule .* - [F,L]

    # Block SQL Injection Attempts
    RewriteCond %{QUERY_STRING} (eval\(|union.*select|insert.*into|drop.*table|<script|<iframe) [NC]
    RewriteRule .* - [F,L]

    # Block Access to Hidden / Sensitive Files (.git, .env, .htaccess, etc)
    RewriteRule ^\.(.*)$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
    # Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://fonts.gstatic.com data: blob:;"

    # Anti-Sniffing Header
    Header set X-Content-Type-Options "nosniff"

    # Anti-Clickjacking Frame Protection
    Header set X-Frame-Options "SAMEORIGIN"

    # Strict XSS Protection
    Header set X-XSS-Protection "1; mode=block"

    # Strict Transport Security (HSTS - 1 Year)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions Policy
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Cloudflare / Reverse Proxy Real IP Headers
    Header set X-Proxy-Shield "Active-AES256"
</IfModule>

# Prevent directory browsing
Options -Indexes
